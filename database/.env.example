# 复制为 .env（勿提交 .env）
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=gis_economy
POSTGRES_USER=gis_app
POSTGRES_PASSWORD=gis_app_dev

# seed 迁移 ALTER 用（默认 postgres/postgres，Docker 同此）
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=postgres

DATABASE_URL=postgresql://gis_app:gis_app_dev@127.0.0.1:5432/gis_economy
